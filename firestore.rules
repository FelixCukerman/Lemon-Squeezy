rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validRecipe() {
      return request.resource.data.keys().hasOnly(['authorId','title','description','imageUrl','categoryIds','dietaryTags','difficulty','totalTimeMinutes','servings','ingredients','steps','status','createdAt','updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 140
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 3000
        && request.resource.data.imageUrl is string && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('https://.+'))
        && (!('dietaryTags' in request.resource.data) || (request.resource.data.dietaryTags is list && request.resource.data.dietaryTags.size() <= 6 && request.resource.data.dietaryTags.hasOnly(['vegetarian','vegan','gluten-free','dairy-free','egg-free','nut-free'])))
        && request.resource.data.categoryIds is list && request.resource.data.categoryIds.size() >= 1 && request.resource.data.categoryIds.size() <= 12
        && request.resource.data.difficulty in ['easy','medium','hard']
        && request.resource.data.totalTimeMinutes is int && request.resource.data.totalTimeMinutes >= 1 && request.resource.data.totalTimeMinutes <= 10080
        && (request.resource.data.servings == null || (request.resource.data.servings is int && request.resource.data.servings >= 1 && request.resource.data.servings <= 100))
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() >= 1 && request.resource.data.ingredients.size() <= 50
        && request.resource.data.steps is list && request.resource.data.steps.size() >= 1 && request.resource.data.steps.size() <= 40
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    match /recipes/{recipeId} {
      allow read: if isAdmin() || resource.data.status == 'published' || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && validRecipe();
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.keys().hasOnly(['authorId','title','description','imageUrl','categoryIds','dietaryTags','difficulty','totalTimeMinutes','servings','ingredients','steps','status','createdAt','updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','imageUrl','categoryIds','dietaryTags','difficulty','totalTimeMinutes','servings','ingredients','steps','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 140
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 3000
        && request.resource.data.imageUrl is string && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('https://.+'))
        && (!('dietaryTags' in request.resource.data) || (request.resource.data.dietaryTags is list && request.resource.data.dietaryTags.size() <= 6 && request.resource.data.dietaryTags.hasOnly(['vegetarian','vegan','gluten-free','dairy-free','egg-free','nut-free'])))
        && request.resource.data.categoryIds is list && request.resource.data.categoryIds.size() >= 1 && request.resource.data.categoryIds.size() <= 12
        && request.resource.data.difficulty in ['easy','medium','hard']
        && request.resource.data.totalTimeMinutes is int && request.resource.data.totalTimeMinutes >= 1 && request.resource.data.totalTimeMinutes <= 10080
        && (request.resource.data.servings == null || (request.resource.data.servings is int && request.resource.data.servings >= 1 && request.resource.data.servings <= 100))
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() >= 1 && request.resource.data.ingredients.size() <= 50
        && request.resource.data.steps is list && request.resource.data.steps.size() >= 1 && request.resource.data.steps.size() <= 40
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    function publishedRecipe(recipeId) {
      return exists(/databases/$(database)/documents/recipes/$(recipeId))
        && get(/databases/$(database)/documents/recipes/$(recipeId)).data.status == 'published';
    }
    match /favorites/{favoriteId} {
      // Direct document reads must also work before a favorite exists.
      allow get: if signedIn() && favoriteId.matches('^' + request.auth.uid + '_.*$');
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId','recipeId','createdAt'])
        && request.resource.data.keys().hasOnly(['userId','recipeId','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipeId is string
        && favoriteId == request.auth.uid + '_' + request.resource.data.recipeId
        && request.resource.data.createdAt == request.time
        && publishedRecipe(request.resource.data.recipeId);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }
    match /ratings/{ratingId} {
      allow read: if true; // Public ratings/comments: list queries cannot prove cross-document checks.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId','recipeId','value','createdAt'])
        && request.resource.data.keys().hasOnly(['userId','recipeId','value','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipeId is string
        && ratingId == request.resource.data.recipeId + '_' + request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1 && request.resource.data.value <= 5
        && request.resource.data.createdAt == request.time
        && publishedRecipe(request.resource.data.recipeId);
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /comments/{commentId} {
      allow read: if true; // Public ratings/comments: list queries cannot prove cross-document checks.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['recipeId','authorId','authorName','text','createdAt'])
        && request.resource.data.keys().hasOnly(['recipeId','authorId','authorName','text','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.recipeId is string
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1500
        && request.resource.data.createdAt == request.time
        && publishedRecipe(request.resource.data.recipeId);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow update: if false;
    }
    match /users/{userId} {
      // Public display name only. Do not store email or private account data here.
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','updatedAt'])
        && request.resource.data.keys().hasAll(['displayName','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }


    // Per-recipe change markers. Written atomically with recipe create/edit/delete.
    // Clients cannot alter the shared compact search-index snapshots.
    match /searchIndexChanges/{recipeId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['deleted','updatedAt'])
        && request.resource.data.keys().hasAll(['deleted','updatedAt'])
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt == request.time
        && (
          (!request.resource.data.deleted
            && existsAfter(/databases/$(database)/documents/recipes/$(recipeId))
            && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.authorId == request.auth.uid
            && getAfter(/databases/$(database)/documents/recipes/$(recipeId)).data.status == 'published')
          || (request.resource.data.deleted
            && exists(/databases/$(database)/documents/recipes/$(recipeId))
            && !existsAfter(/databases/$(database)/documents/recipes/$(recipeId))
            && (get(/databases/$(database)/documents/recipes/$(recipeId)).data.authorId == request.auth.uid || isAdmin()))
        );
      allow delete: if isAdmin();
    }
    match /searchIndex/{indexId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['items','updatedAt','parts','count','complete','revision','prefix','cutoff'])
        && (
          (indexId == 'compactionControl'
            && request.resource.data.keys().hasOnly(['cutoff'])
            && request.resource.data.keys().hasAll(['cutoff'])
            && request.resource.data.cutoff == request.time)
          || (indexId != 'compactionControl'
            && request.resource.data.updatedAt == request.time
            && (indexId == 'manifest' || indexId.matches('part-[0-9][0-9][0-9]') || indexId.matches('g[0-9]+-[0-9]+-part-[0-9][0-9][0-9]')))
        );
      allow delete: if false;
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','normalizedName','approvedBy','createdAt'])
        && request.resource.data.keys().hasAll(['name','normalizedName','approvedBy','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.normalizedName is string && request.resource.data.normalizedName.size() >= 2
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /ingredientSuggestions/{suggestionId} {
      allow get, list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','normalizedName','authorId','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','normalizedName','authorId','status','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.normalizedName is string && request.resource.data.normalizedName.size() >= 2 && request.resource.data.normalizedName.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    // Approximate public view counter. Each write may add exactly one.
    // This is intentionally not bot-proof without a trusted backend.
    match /recipeViews/{recipeId} {
      allow read: if true;
      allow create: if publishedRecipe(recipeId)
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if publishedRecipe(recipeId)
        && resource.data.keys().hasOnly(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }
    match /compatibilityTests/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
